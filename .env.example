# Public address of the site (used for canonical URLs, sitemap and Stripe return links).
NEXT_PUBLIC_SITE_URL=https://vanokibs.vercel.app

# Optional contact details shown on the site (leave empty to hide).
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=

# Stripe (Canada). Without a key, every "Subscribe / Pay" button opens the quote form instead.
STRIPE_SECRET_KEY=
# Set to "true" once Stripe Tax is configured for your GST/HST/QST registrations.
STRIPE_AUTOMATIC_TAX=false

# SMTP for the contact / quote form (any provider: your own, Microsoft 365, Google Workspace, Postmark, SES...).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Where quote requests are delivered, and the From address used.
CONTACT_TO=
CONTACT_FROM=

# Admin at /admin. ADMIN_USERS holds hashed passwords only (see README for the format and how to make a hash).
ADMIN_USERS=
# Fine-grained GitHub token with Contents: Read and write on this repo, so admin saves can be committed.
GITHUB_TOKEN=
GITHUB_REPO=kingkpono2/Vanokibs-whitelabel
GITHUB_BRANCH=main
